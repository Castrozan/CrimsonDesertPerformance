#!/usr/bin/env bash
set -uo pipefail
script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
paused_units=()
for unit in ${CDPERF_PAUSE_USER_UNITS:-}; do
  if [[ "$unit" == hex || "$unit" == hex.* ]]; then
    echo "cdperf: never pausing $unit (voice wake depends on it)" >&2
    continue
  fi
  if systemctl --user is-active -q "$unit" && systemctl --user stop "$unit"; then
    paused_units+=("$unit")
  fi
done
resume_paused_units() {
  if ((${#paused_units[@]})); then
    systemctl --user start "${paused_units[@]}"
  fi
}
free_memory_outside_steam_no_new_privileges() {
  systemd-run --user --wait --collect --quiet --pipe "$script_directory/cdperf-free-memory"
}
trap resume_paused_units EXIT
free_memory_outside_steam_no_new_privileges >&2
"$@"
