#!/usr/bin/env bash
set -uo pipefail
script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
configuration="${XDG_CONFIG_HOME:-$HOME/.config}/cdperf/config"
if [[ -f "$configuration" ]]; then
  source "$configuration"
fi

paused_units=()
for unit in ${CDPERF_PAUSE_USER_UNITS:-}; do
  if [[ "$unit" == hex || "$unit" == hex.* ]]; then
    echo "cdperf: never pausing $unit (voice wake depends on it)" >&2
    continue
  fi
  if systemctl --user is-active -q "$unit" && systemctl --user stop "$unit"; then
    paused_units+=("$unit")
  fi
done

run_outside_steam_no_new_privileges() {
  systemd-run --user --wait --collect --quiet --pipe "$@"
}

stopped_system_units=()
for unit in ${CDPERF_STOP_SYSTEM_UNITS:-}; do
  if [[ "$unit" == hex || "$unit" == hex.* ]]; then
    echo "cdperf: never stopping $unit (voice wake depends on it)" >&2
    continue
  fi
  if systemctl is-active -q "$unit" && run_outside_steam_no_new_privileges sudo -n systemctl stop "$unit"; then
    stopped_system_units+=("$unit")
  fi
done

stopped_containers=()
if [[ -n "${CDPERF_STOP_CONTAINERS_MATCHING:-}" ]]; then
  mapfile -t matching_containers < <(docker ps --format '{{.Names}}' | grep -E -- "$CDPERF_STOP_CONTAINERS_MATCHING")
  if ((${#matching_containers[@]})) && docker stop "${matching_containers[@]}" >/dev/null; then
    stopped_containers=("${matching_containers[@]}")
    echo "cdperf: stopped ${#stopped_containers[@]} containers for this session" >&2
  fi
fi

resume_paused_work() {
  if ((${#paused_units[@]})); then
    systemctl --user start "${paused_units[@]}"
  fi
  if ((${#stopped_containers[@]})); then
    docker start "${stopped_containers[@]}" >/dev/null
  fi
  if ((${#stopped_system_units[@]})); then
    run_outside_steam_no_new_privileges sudo -n systemctl start "${stopped_system_units[@]}"
  fi
}

trap resume_paused_work EXIT
run_outside_steam_no_new_privileges "$script_directory/cdperf-free-memory" >&2
"$@"
